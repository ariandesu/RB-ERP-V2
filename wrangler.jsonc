{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "rosebally-erp-v2",
  "compatibility_date": "2024-12-30",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "rosebally-erp-v2"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "rosebally-erp-v2",
      "database_id": "032d4c14-02dc-468a-843c-a6b734dc2dae"
    }
  ]
}
